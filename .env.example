# Port the addon server runs on (Default: 7860)
PORT=7860

# Public URL of your deployed addon (e.g., https://stremio-tg.yourdomain.com)
ADDON_URL=http://localhost:7860

# Optional API Key to secure your addon (e.g., Gvi4ShwFyYz...)
API_KEY=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Telegram Bot Token from @BotFather (required if USER_SESSION_STRING is not set)
BOT_TOKEN=

# Telegram User Session String (highly recommended to bypass 2GB file limit)
USER_SESSION_STRING=

# Comma-separated list of Telegram Channel IDs to index (e.g., -100xxxxxxxxxx, -100yyyyyyyyyy)
TELEGRAM_CHANNEL_ID=

# Optional: Channel ID to send play/seek/stop logs to (e.g., -100zzzzzzzzzz).
# Logs include your region time, date, year, play count and progress %.
LOG_CHANNEL_ID=

# Optional: Timezone for logging (e.g., Asia/Kolkata, UTC). Defaults to UTC.
TIMEZONE=UTC

# Optional: Cache duration in seconds for search queries (Default: 1800)
CACHE_TTL=1800

# --- Configuration Wizard (web setup at /configure) ---
# Password that unlocks the wizard. If empty, the first visitor can claim it.
CONFIG_PASSWORD=

# --- Posters / genres / localization (TMDB) ---
# Free API key from https://www.themoviedb.org/settings/api (optional; falls back to Cinemeta)
TMDB_API_KEY=
# Language for posters/titles, applied as TMDB language= param (e.g. hi-IN, es-ES). Default: en-US
TMDB_LANGUAGE=en-US

# --- Per-IP rate limiting (enable when sharing publicly) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
RATE_LIMIT_STREAM_REQUESTS=600

# --- Watch history / play logs ---
# Log start/seek/stop events (builds Continue Watching + Telegram logs). Default: true
WATCH_LOG_EVENTS=true

# Directory for the SQLite cache + wizard config (mount as volume to persist)
DATA_DIR=./data
